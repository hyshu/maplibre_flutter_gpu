{
  "version": 8,
  "name": "MapLibre Flutter GPU visual E2E URL GeoJSON",
  "center": [0, 0],
  "zoom": 0,
  "transition": {"duration": 0, "delay": 0},
  "sources": {
    "features": {
      "type": "geojson",
      "data": "__VISUAL_E2E_ASSET_BASE__/geojson/features.json"
    }
  },
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#e7edf3"}},
    {"id": "url-polygon", "type": "fill", "source": "features", "paint": {"fill-color": "#5277c3", "fill-outline-color": "#17283a"}}
  ]
}
